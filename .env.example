# Fixna
APP_NAME=Fixna
PRODUCT_NAME=LocalBoost
BASE_DOMAIN=fixna.in
WEB_URL=https://app.fixna.in
API_URL=https://api.fixna.in

# Local
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL
POSTGRES_DB=fixna
POSTGRES_USER=fixna
POSTGRES_PASSWORD=change-me
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fixna

# Redis
REDIS_URL=redis://localhost:6379

# JWT - generate strong values outside source control
JWT_SECRET=change-me
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# AI
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=

# Advertising
GOOGLE_ADS_ENABLED=false
META_ADS_ENABLED=false
WHATSAPP_ENABLED=false

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
