# Copy to fly.secrets.env (never commit). Load with:
#   fly secrets import --file fly.secrets.env
#
# Generate JWT secret (PowerShell, 48 chars):
#   -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})

SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_HOST/fixna?sslmode=require
POSTGRES_USER=YOUR_NEON_USER
POSTGRES_PASSWORD=YOUR_NEON_PASSWORD
FIXNA_JWT_SECRET=REPLACE_WITH_48_CHAR_RANDOM_SECRET_MIN_32_BYTES
FIXNA_CORS_ALLOWED_ORIGINS=https://app.fixna.in,https://fixna.in
