# Render dashboard → fixna-localboost-api → Environment
# (Neon database fixna — do not use Render Postgres for this demo)

SPRING_PROFILES_ACTIVE=staging
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_HOST/fixna?sslmode=require
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=your_neon_password
FIXNA_JWT_SECRET=REPLACE_WITH_48_CHAR_RANDOM_SECRET
FIXNA_CORS_ALLOWED_ORIGINS=https://app.fixna.in,https://fixna.in,https://YOUR-SERVICE.onrender.com
# Optional ISO-8601 UTC; omit to use image build time from Maven build-info
FIXNA_DEPLOYED_AT=
