# Frontend environment — copy to frontend/.env.local for local values.
# ONLY NEXT_PUBLIC_* values are exposed to the browser. Never put API keys,
# secrets or tokens in any NEXT_PUBLIC_* variable.
#
# Local:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_ENV=local
#
# Shared demo (Vercel production):
# NEXT_PUBLIC_API_BASE_URL=https://api.fixna.in/api
# NEXT_PUBLIC_APP_ENV=demo